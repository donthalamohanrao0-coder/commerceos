ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://commerceos:commerceos@localhost:5432/commerceos
REDIS_URL=redis://localhost:6379/0

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Phase 6: OpenAI (leave unset to use FakeOpenAIClient) ---
OPENAI_API_KEY=

# --- Phase 7: Razorpay test mode (leave unset to use FakeRazorpayClient) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Phase 8: Pinecone (leave unset to skip RAG ingestion/retrieval) ---
PINECONE_API_KEY=
PINECONE_INDEX=

# --- Supabase cutover (leave unset to stay on local Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Observability (all no-op safely when unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
