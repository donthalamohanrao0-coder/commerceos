ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://commerceos:commerceos@localhost:5432/commerceos
REDIS_URL=redis://localhost:6379/0

# Absolute origin this API is reachable at — used to build the hosted checkout URL
# ({PUBLIC_BASE_URL}/pay/{payment_id}) handed to an external AI buyer.
# PUBLIC_BASE_URL=https://commerceos.onrender.com

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Extra allowed origins by regex (defaults to https://.*\.vercel\.app so every
# Vercel preview + production URL works). Set to "" to disable.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Phase 6: OpenAI (leave unset to use FakeOpenAIClient) ---
OPENAI_API_KEY=
# Optional overrides (defaults: gpt-5 / gpt-5-mini / text-embedding-3-small)
OPENAI_REASONING_MODEL=
OPENAI_FAST_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- Phase 7: Razorpay test mode (leave unset to use FakeRazorpayClient) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Phase 8: Pinecone (leave unset to skip RAG ingestion/retrieval) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Supabase cutover (leave unset to stay on local Postgres) ---
# SUPABASE_URL + SUPABASE_ANON_KEY also enable Supabase Auth token verification
# for the frontend (app/integrations/supabase/auth.py). Unset -> FakeTokenVerifier.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# First-time authenticated frontend users are auto-linked to this merchant.
DEMO_MERCHANT_CODE=mrc_novatech_001

# --- Observability (all no-op safely when unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
