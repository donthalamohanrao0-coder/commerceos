# Copy to .env (or set these in the MCP client config's "env" block).

# Where the merchant's Agent Commerce API lives.
AGENT_COMMERCE_BASE_URL=http://localhost:8000/api/v1/agent-commerce

# A scoped key issued from: Merchant console -> AI buyers -> Issue a key
# (leave every scope checked for the full buy flow).
AGENT_COMMERCE_KEY=ack_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE on settlement: request_payment(confirmed=true) returns a Razorpay Payment
# Link (payment_link_url). Paying it (test card 4111 1111 1111 1111) settles the
# order via the backend webhook. Register the webhook once in the Razorpay
# dashboard -> https://<backend>/api/v1/webhooks/razorpay, events:
# payment.captured, payment.failed, payment_link.paid, order.paid.

# --- HTTP transport (remote hosting) ---
# MCP_TRANSPORT=http                 # 'http' serves streamable-http; default 'stdio'
# PORT=8080
# MCP_AUTH_TOKEN=<random-64-hex>     # require `Authorization: Bearer <this>` on the MCP endpoint
# MCP_URL_SECRET=<random-string>     # serve the endpoint at /<string> instead of /mcp
